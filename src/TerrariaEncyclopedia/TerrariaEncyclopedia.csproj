<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net48;netstandard2.0</TargetFrameworks>
    <AssemblyName>TerrariaEncyclopedia</AssemblyName>
    <RootNamespace>TerrariaEncyclopedia</RootNamespace>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <GameFramework Condition="'$(GameFramework)' == ''">Portable</GameFramework>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'net48' and '$(GameFramework)' == 'FNA'">
    <DefineConstants>$(DefineConstants);TERRARIA_FNA</DefineConstants>
    <OutputPath>bin\$(Configuration)\FNA\</OutputPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <ProjectReference Include="..\TerrariaEncyclopedia.Runtime\TerrariaEncyclopedia.Runtime.csproj"
                      AdditionalProperties="GameFramework=FNA;FnaReferencePath=$(FnaReferencePath)" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <ProjectReference Include="..\TerrariaEncyclopedia.Runtime\TerrariaEncyclopedia.Runtime.csproj" />
    <Compile Remove="Compatibility\**\*.cs" />
    <Compile Remove="EncyclopediaFeature.cs" />
    <Compile Remove="UI\ItemBrowserPanel.cs" />
    <Compile Remove="Content\DropCatalogue.cs" />
    <Compile Remove="Content\ItemCatalogue.cs" />
    <Compile Remove="Content\NpcCatalogue.cs" />
    <Compile Remove="Content\RecipeCatalogue.cs" />
    <Compile Remove="Content\TerrariaEncyclopediaDataSource.cs" />
    <Compile Remove="Content\WikiEnrichment.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TerrariaEncyclopedia.Tests" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net48' and '$(GameFramework)' == 'FNA'">
    <Reference Include="Terraria">
      <HintPath>$(TerrariaReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="FNA">
      <HintPath>$(FnaReferencePath)</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <None Include="WikiData\*.json" CopyToOutputDirectory="PreserveNewest"
          Condition="'$(TargetFramework)' == 'net48' and '$(GameFramework)' == 'FNA'" />
  </ItemGroup>

  <Target Name="ValidateGameReferences" BeforeTargets="PrepareForBuild" Condition="'$(TargetFramework)' == 'net48'">
    <Error Condition="'$(GameFramework)' != 'FNA'"
           Text="TerrariaEncyclopedia currently supports only GameFramework=FNA." />
    <Error Condition="'$(GameFramework)' == 'FNA' and '$(TerrariaReferencePath)' == ''"
           Text="FNA feature builds require TerrariaReferencePath." />
    <Error Condition="'$(GameFramework)' == 'FNA' and !Exists('$(TerrariaReferencePath)')"
           Text="TerrariaReferencePath does not exist: $(TerrariaReferencePath)" />
    <Error Condition="'$(GameFramework)' == 'FNA' and '$(FnaReferencePath)' == ''"
           Text="FNA feature builds require FnaReferencePath." />
    <Error Condition="'$(GameFramework)' == 'FNA' and !Exists('$(FnaReferencePath)')"
           Text="FnaReferencePath does not exist: $(FnaReferencePath)" />
  </Target>

</Project>
